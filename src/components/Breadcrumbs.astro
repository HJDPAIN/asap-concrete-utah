---
import Icon from './Icon.astro';
interface Crumb { label: string; href?: string }
interface Props { items: Crumb[]; class?: string }
const { items, class: cls = '' } = Astro.props;
---
<nav aria-label="Breadcrumb" class:list={["text-sm", cls]}>
  <ol class="flex flex-wrap items-center gap-1">
    <li><a href="/" class="inline-flex min-h-8 items-center text-ink-500 hover:text-ink-950 hover:underline underline-offset-4">Home</a></li>
    {items.map((c, i) => (
      <li class="inline-flex items-center gap-1">
        <Icon name="arrow" class="h-3.5 w-3.5 text-ink-300" />
        {c.href && i < items.length - 1 ? <a href={c.href} class="inline-flex min-h-8 items-center text-ink-500 hover:text-ink-950 hover:underline underline-offset-4">{c.label}</a> : <span aria-current="page" class="inline-flex min-h-8 items-center font-semibold text-ink-950">{c.label}</span>}
      </li>
    ))}
  </ol>
</nav>
