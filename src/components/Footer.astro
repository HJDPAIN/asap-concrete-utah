---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { Image } from 'astro:assets';
import logoWhite from '../assets/images/logo-white.png';
import { biz } from '../lib/site';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---
<footer class="bg-ink-950 text-ink-200">
  <div class="container-x grid gap-10 py-16 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <Image src={logoWhite} alt="ASAP Concrete Cutting" width={180} height={55} densities={[1, 2]} loading="eager" class="h-12 w-auto" />
      <p class="mt-3 max-w-xs">Concrete cutting, core drilling, scanning and demolition. Based in {biz.city}, {biz.stateFull}.</p>
      <address class="mt-4 not-italic">
        <a href={biz.phoneHref} class="inline-flex min-h-11 items-center gap-2 text-lg font-semibold text-white hover:text-brand-500"><Icon name="phone" class="h-5 w-5" />{biz.phone}</a>
        <p class="text-sm text-ink-300">{biz.phoneNote}</p>
        <p class="mt-2 text-sm text-ink-300">{biz.city}, {biz.state}</p>
      </address>
      <ul class="mt-4 flex gap-2">
        <li><a href={biz.social.facebook} rel="noopener" target="_blank" class="inline-flex h-11 w-11 items-center justify-center rounded-lg hover:bg-white/10" aria-label="ASAP Concrete Cutting on Facebook (opens in new tab)"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.6 1.6-1.6h1.7V4.4c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.3H7.4V14h2.8v8h3.3z"/></svg></a></li>
        <li><a href={biz.social.instagram} rel="noopener" target="_blank" class="inline-flex h-11 w-11 items-center justify-center rounded-lg hover:bg-white/10" aria-label="ASAP Concrete Cutting on Instagram (opens in new tab)"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a></li>
      </ul>
    </div>
    <nav aria-label="Footer services">
      <h2 class="font-display text-base font-bold uppercase tracking-wider text-white">Services</h2>
      <ul class="mt-4 grid gap-1">
        {services.map(s => <li><a href={`/services/${s.data.slug}/`} class="inline-block py-1.5 hover:text-white hover:underline underline-offset-4">{s.data.title}</a></li>)}
      </ul>
    </nav>
    <div>
      <h2 class="font-display text-base font-bold uppercase tracking-wider text-white">Service areas</h2>
      <ul class="mt-4 grid gap-1">
        {biz.serviceAreas.map(a => <li class="py-1.5">{a.name}</li>)}
      </ul>
      <p class="mt-3 text-sm text-ink-300">{biz.travelNote}</p>
      <a href="/service-areas/" class="mt-2 inline-flex min-h-11 items-center gap-1 font-semibold text-brand-500 hover:underline underline-offset-4">All service areas <Icon name="arrow" class="h-4 w-4" /></a>
    </div>
    <nav aria-label="Footer">
      <h2 class="font-display text-base font-bold uppercase tracking-wider text-white">Company</h2>
      <ul class="mt-4 grid gap-1">
        <li><a href="/about/" class="inline-block py-1.5 hover:text-white hover:underline underline-offset-4">About</a></li>
        <li><a href="/projects/" class="inline-block py-1.5 hover:text-white hover:underline underline-offset-4">Projects</a></li>
        <li><a href="/resources/" class="inline-block py-1.5 hover:text-white hover:underline underline-offset-4">Resources</a></li>
        <li><a href="/contact/" class="inline-block py-1.5 hover:text-white hover:underline underline-offset-4">Get a free quote</a></li>
        <li><a href="/privacy/" class="inline-block py-1.5 hover:text-white hover:underline underline-offset-4">Privacy policy</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-2 py-6 text-sm text-ink-300 sm:flex-row sm:justify-between">
      <p>© {year} {biz.name}. All rights reserved.</p>
      <p>“{biz.tagline}”</p>
    </div>
  </div>
</footer>
