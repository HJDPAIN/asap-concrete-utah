---
interface Props { label: string; class?: string; aspect?: string }
const { label, class: cls = '', aspect = 'aspect-[4/3]' } = Astro.props;
---
<div class:list={["flex items-center justify-center rounded-xl border-2 border-dashed border-ink-300 bg-ink-100 p-4 text-center", aspect, cls]} role="img" aria-label={label}>
  <span class="text-sm font-semibold uppercase tracking-wider text-ink-700">{label}</span>
</div>
