---
import reviews from '../content/reviews.json';
import Icon from './Icon.astro';
---
<section class="section bg-ink-50" aria-labelledby="reviews-title">
  <div class="container-x">
    <div class="max-w-[48ch]">
      <p class="eyebrow">Reviews</p>
      <h2 id="reviews-title" class="mt-2">What customers say</h2>
      <p class="mt-3 text-lg">Real reviews from the people we have worked for.</p>
    </div>
    <ul class="mt-10 grid gap-6 md:grid-cols-3" role="list">
      {reviews.map(r => (
        <li class="card flex flex-col">
          <div class="flex gap-0.5 text-cta-600" role="img" aria-label={`${r.rating} out of 5 stars`}>
            {Array.from({ length: r.rating }).map(() => <Icon name="star" class="h-5 w-5 fill-current" />)}
          </div>
          <blockquote class="mt-4 flex-1 text-lg text-ink-950">“{r.quote}”</blockquote>
          <footer class="mt-5 text-sm text-ink-500"><span class="font-semibold text-ink-700">{r.author}</span> · {r.service} · <time datetime={r.date}>{r.dateDisplay}</time></footer>
        </li>
      ))}
    </ul>
  </div>
</section>
