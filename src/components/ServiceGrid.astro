---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
interface Props { limit?: number; heading?: boolean }
const { limit, heading = true } = Astro.props;
let services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
if (limit) services = services.slice(0, limit);
const H = heading ? 'h3' : 'h2';
---
<section class="section" aria-labelledby={heading ? 'services-title' : undefined}>
  <div class="container-x">
    {heading && (
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div class="max-w-[48ch]">
          <p class="eyebrow">Services</p>
          <h2 id="services-title" class="mt-2">Cutting, coring, scanning and removal</h2>
          <p class="mt-3 text-lg">Ten services, one crew, the right equipment for each. Pick the job you need done.</p>
        </div>
        <a href="/services/" class="btn-ghost self-start md:self-auto">All services <Icon name="arrow" class="h-4 w-4" /></a>
      </div>
    )}
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {services.map(s => (
        <li>
          <a href={`/services/${s.data.slug}/`} class="card group flex h-full flex-col gap-3 transition-colors duration-150 hover:border-brand-700 motion-reduce:transition-none">
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-brand-50 text-brand-700"><Icon name={s.data.icon} class="h-7 w-7" /></span>
            <H class="font-display text-xl font-bold text-ink-950 tracking-tight group-hover:text-brand-700">{s.data.title}</H>
            <p class="flex-1">{s.data.summary}</p>
            <span class="inline-flex items-center gap-1 font-semibold text-brand-700">Learn more <Icon name="arrow" class="h-4 w-4" /><span class="sr-only"> about {s.data.title}</span></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
