---
import Icon from './Icon.astro';
import { biz } from '../lib/site';
---
<div class="fixed inset-x-0 bottom-0 z-30 grid grid-cols-2 gap-2 border-t border-ink-200 bg-white p-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] lg:hidden" role="region" aria-label="Quick actions">
  <a href={biz.phoneHref} class="btn-primary"><Icon name="phone" class="h-5 w-5" />Call now</a>
  <a href="/contact/" class="btn-secondary">Free quote</a>
</div>
