---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import faqs from '../content/faqs.json';
import { biz } from '../lib/site';
import { breadcrumbSchema, faqSchema } from '../lib/schema';
const crumbs = [{ label: 'Contact', href: '/contact/' }];
const contactSchema = { '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Contact ASAP Concrete Cutting', mainEntity: { '@id': `${biz.siteUrl}/#business` } };
---
<Base title="Get a Free Concrete Cutting Quote" description="Request a free quote from ASAP Concrete Cutting in Logan, UT. Call or text (435) 760-0806, or send job details and a photo. Serving Cache Valley to Salt Lake City." schema={[breadcrumbSchema(crumbs), contactSchema, faqSchema(faqs)]}>
  <PageHeader title="Get a free quote" intro="Fastest way: call or text. Prefer to type? Send the form and we will get back to you." crumbs={crumbs} eyebrow="Contact" />
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_360px]">
      <div>
        <h2 class="text-2xl">Tell us about the job</h2>
        <p class="mt-2 max-w-[60ch]">Leave a detailed description of your job: concrete thickness, location, how many feet need cut, core drill hole size, and so on. More detail means a faster, more accurate quote.</p>
        <div class="mt-8"><QuoteForm /></div>
      </div>
      <aside class="grid content-start gap-6">
        <div class="card bg-ink-950 text-white">
          <p class="eyebrow !text-brand-500">Call or text</p>
          <a href={biz.phoneHref} class="mt-2 inline-flex min-h-11 items-center gap-2 font-display text-3xl font-bold text-white hover:text-brand-500"><Icon name="phone" class="h-7 w-7" />{biz.phone}</a>
          <p class="mt-3 text-ink-200">Texting a photo of the slab or wall is often the quickest way to get a number.</p>
        </div>
        <div class="card">
          <h2 class="text-lg">Location</h2>
          <p class="mt-1">{biz.city}, {biz.stateFull}</p>
          <p class="mt-1 text-sm text-ink-500">{biz.addressTodo}</p>
          <h2 class="mt-5 text-lg">Hours</h2>
          <p class="mt-1 text-sm text-ink-500">{biz.hoursTodo}</p>
          <h2 class="mt-5 text-lg">Email</h2>
          <p class="mt-1 text-sm text-ink-500">{biz.emailTodo}</p>
        </div>
        <div class="card">
          <h2 class="text-lg">Service areas</h2>
          <ul class="mt-2 flex flex-wrap gap-2">{biz.serviceAreas.map(a => <li class="rounded-full bg-ink-100 px-3 py-1 text-sm font-semibold text-ink-700">{a.name}</li>)}</ul>
          <p class="mt-3 text-sm text-ink-500">{biz.travelNote}</p>
        </div>
      </aside>
    </div>
  </section>
  <div class="bg-ink-50"><Steps /></div>
  <Faq faqs={faqs} />
</Base>
