---
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Cta from '../../components/Cta.astro';
import Icon from '../../components/Icon.astro';
import { img } from '../../lib/images';
import { abs, biz } from '../../lib/site';
import { breadcrumbSchema } from '../../lib/schema';
export async function getStaticPaths() {
  const posts = await getCollection('articles');
  return posts.map(p => ({ params: { slug: p.data.slug }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const m = img(d.image)!;
const service = (await getCollection('services')).find(s => s.data.slug === d.relatedService);
const crumbs = [{ label: 'Resources', href: '/resources/' }, { label: d.title, href: `/resources/${d.slug}/` }];
const fmt = (x: Date) => x.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const article = { '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description, datePublished: d.date.toISOString().slice(0,10), image: abs(m.src), author: { '@type': 'Organization', name: biz.name }, publisher: { '@id': abs('/#business') }, mainEntityOfPage: abs(`/resources/${d.slug}/`) };
---
<Base title={d.title} description={d.description} schema={[breadcrumbSchema(crumbs), article]} ogImage={m}>
  <article>
    <header class="border-b border-ink-200 bg-ink-50">
      <div class="container-x py-10 md:py-14">
        <Breadcrumbs items={crumbs} class="mb-4" />
        <p class="eyebrow">{d.category}</p>
        <h1 class="mt-2 max-w-[22ch]">{d.title}</h1>
        <p class="mt-4 text-ink-500"><time datetime={d.date.toISOString().slice(0,10)}>{fmt(d.date)}</time> · {biz.name}</p>
      </div>
    </header>
    <div class="container-x section grid gap-12 lg:grid-cols-[1fr_340px]">
      <div>
        <Picture src={m} alt={d.imageAlt} widths={[480, 800, 1200]} sizes="(min-width:1024px) 780px, 100vw" formats={['avif','webp']} loading="eager" fetchpriority="high" decoding="async" class="aspect-[16/10] w-full rounded-2xl object-cover" />
        <div class="prose-body mt-8"><Content /></div>
      </div>
      <aside class="grid content-start gap-6">
        {service && <div class="card"><p class="eyebrow">Related service</p><h2 class="mt-1 text-xl">{service.data.title}</h2><p class="mt-2">{service.data.summary}</p><a href={`/services/${service.data.slug}/`} class="mt-3 inline-flex min-h-11 items-center gap-1 font-semibold text-brand-700 hover:underline underline-offset-4">Learn more <Icon name="arrow" class="h-4 w-4" /></a></div>}
        <div class="card bg-ink-950 text-white"><h2 class="text-xl text-white">Have a question?</h2><p class="mt-2 text-ink-200">Call or text and we will help you plan the job.</p><a href={biz.phoneHref} class="btn-primary mt-4 w-full"><Icon name="phone" class="h-5 w-5" />{biz.phone}</a></div>
      </aside>
    </div>
  </article>
  <Cta />
</Base>
