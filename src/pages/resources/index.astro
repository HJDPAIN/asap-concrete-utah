---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Cta from '../../components/Cta.astro';
import { img } from '../../lib/images';
import { breadcrumbSchema } from '../../lib/schema';
const posts = (await getCollection('articles')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const crumbs = [{ label: 'Resources', href: '/resources/' }];
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title="Concrete Cutting Resources & Guides" description="Plain-English guides from ASAP Concrete Cutting: egress windows, concrete sealing, demolition, core drilling tips, and why you should scan before you cut." schema={[breadcrumbSchema(crumbs)]}>
  <PageHeader title="Helpful articles" intro="If you have any questions about your project, give us a call. We are happy to help." crumbs={crumbs} eyebrow="Resources" />
  <section class="section">
    <div class="container-x">
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" role="list">
        {posts.map(p => { const m = img(p.data.image)!; return (
          <li class="card group overflow-hidden p-0">
            <a href={`/resources/${p.data.slug}/`} class="block">
              <Picture src={m} alt={p.data.imageAlt} widths={[400, 800]} sizes="(min-width:1024px) 380px, (min-width:768px) 50vw, 100vw" formats={['avif','webp']} loading="lazy" decoding="async" class="aspect-[16/10] w-full object-cover" />
              <div class="p-6">
                <p class="text-sm text-ink-500"><time datetime={p.data.date.toISOString().slice(0,10)}>{fmt(p.data.date)}</time> · {p.data.category}</p>
                <h2 class="mt-2 text-xl group-hover:text-brand-700">{p.data.title}</h2>
                <p class="mt-2">{p.data.description}</p>
              </div>
            </a>
          </li>
        ); })}
      </ul>
    </div>
  </section>
  <Cta />
</Base>
