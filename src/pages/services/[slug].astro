---
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Placeholder from '../../components/Placeholder.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import Icon from '../../components/Icon.astro';
import { img } from '../../lib/images';
import { biz } from '../../lib/site';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../lib/schema';
export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map(s => ({ params: { slug: s.data.slug }, props: { service: s } }));
}
const { service } = Astro.props;
const { Content } = await render(service);
const d = service.data;
const main = img(d.image);
const gallery = d.gallery.map(k => img(k)).filter(Boolean);
const others = (await getCollection('services')).filter(s => s.data.slug !== d.slug).sort((a, b) => a.data.order - b.data.order).slice(0, 4);
const articles = (await getCollection('articles')).filter(a => a.data.relatedService === d.slug);
const crumbs = [{ label: 'Services', href: '/services/' }, { label: d.title, href: `/services/${d.slug}/` }];
const schema = [breadcrumbSchema(crumbs), serviceSchema(d), ...(d.faqs.length ? [faqSchema(d.faqs)] : [])];
---
<Base title={d.metaTitle} description={d.metaDescription} schema={schema} ogImage={main}>
  <PageHeader title={d.title} intro={d.summary} crumbs={crumbs} eyebrow="Service">
    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <a href={biz.phoneHref} class="btn-primary"><Icon name="phone" class="h-5 w-5" />{biz.phone}</a>
      <a href="/contact/" class="btn-secondary">Get a Free Quote</a>
    </div>
  </PageHeader>
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-[1fr_380px]">
      <article>
        {main ? (
          <Picture src={main} alt={d.imageAlt} widths={[480, 800, 1200]} sizes="(min-width:1024px) 780px, 100vw" formats={['avif','webp']} loading="eager" fetchpriority="high" decoding="async" class="aspect-[16/10] w-full rounded-2xl object-cover" />
        ) : (
          <Placeholder label={d.placeholder ?? 'Photo needed'} aspect="aspect-[16/10]" />
        )}
        <div class="prose-body mt-8"><Content /></div>
        {gallery.length > 0 && (
          <div class="mt-10 grid gap-4 sm:grid-cols-2">
            {gallery.map(g => <Picture src={g!} alt="" widths={[400, 800]} sizes="(min-width:640px) 380px, 100vw" formats={['avif','webp']} loading="lazy" decoding="async" class="aspect-[4/3] w-full rounded-xl object-cover" />)}
          </div>
        )}
        {articles.length > 0 && (
          <div class="mt-10 rounded-xl border border-ink-200 bg-ink-50 p-6">
            <h2 class="text-xl">From our resources</h2>
            <ul class="mt-3 grid gap-2">{articles.map(a => <li><a href={`/resources/${a.data.slug}/`} class="inline-flex min-h-11 items-center gap-1 font-semibold text-brand-700 hover:underline underline-offset-4">{a.data.title} <Icon name="arrow" class="h-4 w-4" /></a></li>)}</ul>
          </div>
        )}
      </article>
      <aside class="grid content-start gap-6">
        <div class="card bg-ink-950 text-white">
          <h2 class="text-xl text-white">Get a free quote</h2>
          <p class="mt-2 text-ink-200">Call or text with the job location, concrete thickness and what needs cut. We answer fast.</p>
          <a href={biz.phoneHref} class="btn-primary mt-4 w-full"><Icon name="phone" class="h-5 w-5" />{biz.phone}</a>
          <a href="/contact/" class="btn-dark mt-2 w-full">Send details online</a>
        </div>
        <div class="card">
          <h2 class="text-lg">Service areas</h2>
          <ul class="mt-2 flex flex-wrap gap-2">{biz.serviceAreas.map(a => <li class="rounded-full bg-ink-100 px-3 py-1 text-sm font-semibold text-ink-700">{a.name}</li>)}</ul>
          <p class="mt-3 text-sm text-ink-500">{biz.travelNote}</p>
        </div>
        <div class="card">
          <h2 class="text-lg">Other services</h2>
          <ul class="mt-2 divide-y divide-ink-200">{others.map(o => <li><a href={`/services/${o.data.slug}/`} class="flex min-h-11 items-center justify-between py-2 font-semibold text-ink-950 hover:text-brand-700">{o.data.title}<Icon name="arrow" class="h-4 w-4" /></a></li>)}</ul>
        </div>
      </aside>
    </div>
  </section>
  {d.faqs.length > 0 && <div class="bg-ink-50"><Faq faqs={d.faqs} title={`${d.title} questions`} compact /></div>}
  <Cta title={`Need ${d.title.toLowerCase()}?`} />
</Base>
